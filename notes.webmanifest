{
  "id": "notes.html",
  "name": "Notes",
  "short_name": "Notes",
  "description": "Notes and checklists that sync between your phone and computer, encrypted on your own devices.",
  "start_url": "notes.html",
  "scope": "./notes",
  "display": "standalone",
  "background_color": "#161616",
  "theme_color": "#161616",
  "icons": [
    { "src": "notes-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "notes-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "notes-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New note", "url": "notes.html#new", "icons": [{ "src": "notes-icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "notes.html",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
